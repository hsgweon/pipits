#!/usr/bin/env python3

"""
Generates a tab-separated list file (SampleID, ForwardRead, ReverseRead)
for paired-end FASTQ files found in an input directory. Intended for use
with pipits_prep. Now accepts .fq.gz and custom extensions.
"""

import sys
import os
import argparse
import logging
import time
from collections import defaultdict

__version__    = "4.0" # Version incremented for new features

__author__     = "Hyun Soon Gweon (Adapted for PIPITS)"
__copyright__  = "Copyright 2015-2024, The PIPITS Project / PISPINO"
__credits__    = ["Hyun Soon Gweon", "Anna Oliver", "Joanne Taylor", "Tim Booth", "Melanie Gibbs", "Daniel S. Read", "Robert I. Griffiths", "Karsten Schonrogge"]
__license__    = "GPL"
__maintainer__ = "PIPITS Maintainers"
# __email__      = "" # Add appropriate PIPITS contact if desired

# --- ANSI Color Codes ---
class Colors:
    RESET = '\033[0m'
    RED = '\033[91m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    BLUE = '\033[94m'
    MAGENTA = '\033[95m'
    CYAN = '\033[96m'
    HEADER = '\033[95m'

# --- Logging Setup ---
def setup_logging(verbose):
    """Sets up basic logging to console."""
    log_format_console = '%(levelname)s: %(message)s'
    log_level = logging.DEBUG if verbose else logging.INFO

    logger = logging.getLogger()
    # Clear existing handlers to avoid duplicate logs if run multiple times
    if logger.hasHandlers():
        logger.handlers.clear()

    logger.setLevel(log_level) # Set the threshold for the logger

    # Console handler
    console_handler = logging.StreamHandler(sys.stdout)
    console_handler.setLevel(log_level) # Set the threshold for this handler
    console_formatter = logging.Formatter(log_format_console)
    console_handler.setFormatter(console_formatter)
    logger.addHandler(console_handler)

# --- Core Function ---
def make_read_pairs_list(input_dir, output_file, label_add_c_front, label_add_c_end, label_add_reindex_c, ignore_missing_pairs, extra_extensions, verbose): # Added extra_extensions
    """
    Scans input directory for FASTQ files, pairs them, and writes a list file.
    """
    setup_logging(verbose) # Setup logging based on verbosity

    logging.info(f"{Colors.BLUE}Scanning input directory '{input_dir}' for FASTQ files...{Colors.RESET}")

    # Find potential FASTQ files (handles common extensions + custom)
    fastq_files = []
    # *** MODIFICATION 1: Added '.fq.gz' to default extensions ***
    valid_extensions_default = (".fastq", ".fastq.gz", ".fastq.bz2", ".fq.gz")
    # Combine default and user-provided extensions
    valid_extensions_all = set(valid_extensions_default)
    if extra_extensions:
        # Ensure user extensions start with a dot and are lowercase
        user_ext = {ext.lower() if ext.startswith('.') else '.' + ext.lower() for ext in extra_extensions}
        valid_extensions_all.update(user_ext)
        logging.info(f"Including user-specified extensions: {', '.join(sorted(list(user_ext)))}")

    # Convert back to tuple for endswith()
    valid_extensions_tuple = tuple(sorted(list(valid_extensions_all)))
    logging.debug(f"Effective valid extensions: {valid_extensions_tuple}")


    try:
        for item in os.listdir(input_dir):
            # *** MODIFICATION 2: Check against combined extensions tuple ***
            if item.lower().endswith(valid_extensions_tuple):
                # Check if it's actually a file
                if os.path.isfile(os.path.join(input_dir, item)):
                     fastq_files.append(item)
                else:
                     logging.debug(f"Skipping non-file item: {item}")
            else:
                 logging.debug(f"Skipping item: {item} (doesn't end with valid extensions)")
    except FileNotFoundError:
         logging.critical(f"Input directory not found: {input_dir}")
         sys.exit(1)
    except Exception as e:
         logging.critical(f"Error listing files in directory {input_dir}: {e}")
         sys.exit(1)


    if not fastq_files:
        # *** MODIFICATION 3: Update critical message formatting ***
        logging.critical(f"No FASTQ files ({', '.join(valid_extensions_tuple)}) found in directory: {input_dir}")
        sys.exit(1)

    logging.info(f"Found {len(fastq_files)} potential FASTQ files.")

    # --- Identify Sample Prefixes and Group Files ---
    # Assumes prefix is the part before the first underscore '_'
    file_groups = defaultdict(list)
    prefixes = set()
    problematic_prefixes = set()

    for f in fastq_files:
        try:
            prefix = f.split("_", 1)[0]
            file_groups[prefix].append(f)
            prefixes.add(prefix)
        except IndexError:
            logging.warning(f"Could not determine prefix (no '_') for file: {f}. Skipping.")
            continue

    # --- Check for Issues (Missing Pairs, Singletons, Multiples > 2) ---
    final_pairs = {} # Key: prefix, Value: tuple (fwd_file, rev_file)
    offending_prefixes = set()

    for prefix in sorted(list(prefixes)):
        group = sorted(file_groups[prefix]) # Sort files within the group for consistent pairing attempt
        if len(group) == 2:
            # Simple case: Assume the sorted list gives R1 then R2 (or similar)
            # A more robust check might look for _R1_, _R2_ or _1, _2 in filenames
            fwd = group[0]
            rev = group[1]
            logging.debug(f"Paired prefix '{prefix}': {fwd}, {rev}")
            final_pairs[prefix] = (fwd, rev)
        elif len(group) == 1:
             logging.warning(f"Prefix '{prefix}' has only one file: {group[0]}. Cannot form a pair.")
             offending_prefixes.add(prefix)
        else: # More than 2 files
             logging.warning(f"Prefix '{prefix}' has {len(group)} files: {', '.join(group)}. Cannot reliably form a single pair.")
             offending_prefixes.add(prefix)

    if offending_prefixes:
        message = f"Found issues for {len(offending_prefixes)} prefixes (single files or >2 files): {', '.join(sorted(list(offending_prefixes)))}"
        if not ignore_missing_pairs:
            logging.critical(message)
            logging.critical("Cannot proceed with ambiguous/incomplete pairs.")
            logging.critical("Please check file naming consistency or use --ignore-missing-pairs to proceed with complete pairs only.")
            sys.exit(1)
        else:
            logging.warning(message)
            logging.warning("--ignore-missing-pairs specified. Proceeding with complete pairs only.")

    if not final_pairs:
         logging.critical("No complete pairs could be identified. Exiting.")
         sys.exit(1)


    # --- Write Output File ---
    output_filename = output_file if output_file else "readpairslist.txt"
    logging.info(f"Writing pairs list to: {output_filename}")

    try:
        with open(output_filename, "w") as outfile:
            outfile.write("# PIPITS Read Pairs List\n")
            outfile.write("# Generated on: " + time.strftime("%Y-%m-%d %H:%M:%S") + "\n")
            outfile.write("# Input directory: " + os.path.abspath(input_dir) + "\n")
            outfile.write("# SampleID\tForwardReadFilename\tReverseReadFilename\n")

            count = 1
            # Sort by original prefix for consistent output order
            for prefix in sorted(final_pairs.keys()):
                fwd_file, rev_file = final_pairs[prefix]

                # Apply relabeling if requested
                original_label = prefix
                final_label = original_label
                if label_add_c_front:
                    final_label = label_add_c_front + original_label
                elif label_add_c_end:
                    final_label = original_label + label_add_c_end
                elif label_add_reindex_c:
                    # Pad sequence number (e.g., 001, 010, 100)
                    num_digits = 3 # Default padding
                    if len(final_pairs) > 999: num_digits = 4
                    if len(final_pairs) > 9999: num_digits = 5 # Adjust if needed
                    final_label = label_add_reindex_c + str(count).zfill(num_digits)

                # Check final label for forbidden characters
                if "_" in final_label:
                    logging.error(f"Final generated SampleID '{final_label}' contains forbidden character '_'. Check prefix/relabeling options.")
                    # Skip writing this entry? Or fail? Let's fail.
                    raise ValueError(f"Generated SampleID '{final_label}' contains '_'")
                if " " in final_label:
                     logging.error(f"Final generated SampleID '{final_label}' contains forbidden character ' '.")
                     raise ValueError(f"Generated SampleID '{final_label}' contains ' '")


                outfile.write(f"{final_label}\t{fwd_file}\t{rev_file}\n")
                count += 1

        logging.info(f"{Colors.GREEN}Successfully wrote {len(final_pairs)} pairs to {output_filename}{Colors.RESET}")

    except IOError as e:
        logging.critical(f"Could not write output file {output_filename}: {e}")
        sys.exit(1)
    except ValueError as e: # Catch label errors
         logging.critical(f"Error generating SampleID: {e}")
         # Clean up potentially partially written file?
         try: os.remove(output_filename)
         except OSError: pass
         sys.exit(1)
    except Exception as e:
        logging.critical(f"An unexpected error occurred during file writing: {e}")
        sys.exit(1)



def main():
    """Entry point function for setuptools."""
    # Parse arguments inside main to avoid global scope issues if imported
    parser = argparse.ArgumentParser(
        description="Creates a read pairs list file for PIPITS from a directory of FASTQ files.")
    # ... (copy all the parser.add_argument lines from the bottom) ...
    parser.add_argument('--version', action='version', version=f'%(prog)s {__version__}')
    options = parser.parse_args()

    # --- Validate Relabeling Options --- (Copy this validation block)
    label_options_count = sum(1 for opt in [options.label_add_c_front, options.label_add_c_end, options.label_add_reindex_c] if opt is not None)
    if label_options_count > 1:
         parser.error("Please use only one of --label-prefix, --label-suffix, or --relabel options at a time.")

    forbidden_chars = ['_', ' ']
    if options.label_add_c_front and any(c in options.label_add_c_front for c in forbidden_chars):
        parser.error(f"--label-prefix cannot contain forbidden characters: {' '.join(forbidden_chars)}")
    if options.label_add_c_end and any(c in options.label_add_c_end for c in forbidden_chars):
        parser.error(f"--label-suffix cannot contain forbidden characters: {' '.join(forbidden_chars)}")
    if options.label_add_reindex_c and any(c in options.label_add_reindex_c for c in forbidden_chars):
        parser.error(f"--relabel text cannot contain forbidden characters: {' '.join(forbidden_chars)}")

    # Call the main logic function
    make_read_pairs_list(
        input_dir=options.inputdir,
        output_file=options.output,
        label_add_c_front=options.label_add_c_front,
        label_add_c_end=options.label_add_c_end,
        label_add_reindex_c=options.label_add_reindex_c,
        ignore_missing_pairs=options.ignore_missing_pairs,
        extra_extensions=options.extra_extensions,
        verbose=options.verbose
    )
    # No need for sys.exit(0) here usually

# --- Main Execution ---
if __name__ == '__main__':

    parser = argparse.ArgumentParser(
        description="Creates a read pairs list file for PIPITS from a directory of FASTQ files.")
    parser.add_argument(
        "-i", "--inputdir",
        action = "store",
        dest = "inputdir",
        metavar = "<DIR>",
        help = "[REQUIRED] Directory containing raw paired-end sequence files (FASTQ format, can be .gz or .bz2 compressed). Files should be named like 'SampleID_...R1...' and 'SampleID_...R2...'.",
        required = True)
    parser.add_argument(
        "-o", "--output",
        action = "store",
        dest = "output",
        metavar = "<FILE>",
        help = "Name of the output list file [default: readpairslist.txt]",
        required = False,
        default = None) # Default handled in function
    parser.add_argument(
        "--label-prefix", # Renamed for clarity
        action = "store",
        dest = "label_add_c_front",
        metavar = "<TXT>",
        help = "Add a specified prefix string to the beginning of each SampleID in the output file. Forbidden characters: '_', ' '.",
        required = False)
    parser.add_argument(
        "--label-suffix", # Renamed for clarity
        action = "store",
        dest = "label_add_c_end",
        metavar = "<TXT>",
        help = "Add a specified suffix string to the end of each SampleID in the output file. Forbidden characters: '_', ' '.",
        required = False)
    parser.add_argument(
        "--relabel", # Renamed for clarity
        action = "store",
        dest = "label_add_reindex_c",
        metavar = "<TXT>",
        help = "Rename all samples using the given text as a base, automatically appending sequential numbers (e.g., 'prefix001', 'prefix002'). Forbidden characters: '_', ' '.",
        required = False)
    # *** MODIFICATION 4: Added --extra-extensions argument ***
    parser.add_argument(
        "--extra-extensions",
        action = "store",
        dest = "extra_extensions",
        nargs='+', # Allows one or more arguments
        metavar = "<EXT>",
        help = "Additional file extensions to recognize as FASTQ (e.g., .fq .FQ.GZ). Case-insensitive. Include the dot if desired.",
        required=False,
        default=None)
    parser.add_argument(
        "--ignore-missing-pairs", # Renamed from -f for clarity
        action = "store_true",
        dest = "ignore_missing_pairs",
        default = False,
        help = "Ignore prefixes with missing pairs (singletons or >2 files) and create the list file using only complete pairs.",
        required = False)
    parser.add_argument(
        "-v", "--verbose",
        action = "store_true",
        dest = "verbose",
        default=False,
        help = "Verbose mode (log debug messages).",
        required = False)
    parser.add_argument('--version', action='version', version=f'%(prog)s {__version__}')

    options = parser.parse_args()

    # --- Validate Relabeling Options ---
    label_options_count = sum(1 for opt in [options.label_add_c_front, options.label_add_c_end, options.label_add_reindex_c] if opt is not None)
    if label_options_count > 1:
         parser.error("Please use only one of --label-prefix, --label-suffix, or --relabel options at a time.")

    forbidden_chars = ['_', ' ']
    if options.label_add_c_front and any(c in options.label_add_c_front for c in forbidden_chars):
        parser.error(f"--label-prefix cannot contain forbidden characters: {' '.join(forbidden_chars)}")
    if options.label_add_c_end and any(c in options.label_add_c_end for c in forbidden_chars):
        parser.error(f"--label-suffix cannot contain forbidden characters: {' '.join(forbidden_chars)}")
    if options.label_add_reindex_c and any(c in options.label_add_reindex_c for c in forbidden_chars):
        parser.error(f"--relabel text cannot contain forbidden characters: {' '.join(forbidden_chars)}")

    # --- Run the main function ---
    make_read_pairs_list(
        input_dir=options.inputdir,
        output_file=options.output,
        label_add_c_front=options.label_add_c_front,
        label_add_c_end=options.label_add_c_end,
        label_add_reindex_c=options.label_add_reindex_c,
        ignore_missing_pairs=options.ignore_missing_pairs,
        extra_extensions=options.extra_extensions, # Pass new argument
        verbose=options.verbose
    )

    sys.exit(0) # Exit with success code
    
