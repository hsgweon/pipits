class Colors:
    RESET = '\033[0m'
    RED = '\033[91m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    BLUE = '\033[94m'
    MAGENTA = '\033[95m'
    CYAN = '\033[96m'

# --- Custom Logger Formatter with Color ---
class ColorFormatter(logging.Formatter):
    LOG_COLORS = {
        logging.DEBUG: Colors.CYAN,
        logging.INFO: Colors.BLUE,
        logging.WARNING: Colors.YELLOW,
        logging.ERROR: Colors.RED,
        logging.CRITICAL: Colors.MAGENTA
    }

    def format(self, record):
        log_message = super().format(record)
        handler = getattr(self, 'handler', None)
        is_console = False
        if handler and hasattr(handler, 'stream'):
            is_console = handler.stream in (sys.stdout, sys.stderr)
        if is_console and sys.stdout.isatty():
             color = self.LOG_COLORS.get(record.levelno, Colors.RESET)
             return f"{color}{log_message}{Colors.RESET}"
        else:
             log_message = log_message.replace(Colors.RED, '').replace(Colors.GREEN, '').replace(Colors.YELLOW, '') \
                                    .replace(Colors.BLUE, '').replace(Colors.MAGENTA, '').replace(Colors.CYAN, '') \
                                    .replace(Colors.RESET, '')
             return log_message

# --- Helper Functions ---

def setup_logging(log_file_path, verbose):
    """Sets up logging to file and colorful console output."""
    log_format_file = '%(asctime)s - %(levelname)s - %(message)s'
    log_format_console = '%(levelname)s: %(message)s'
    log_level = logging.DEBUG if verbose else logging.INFO
    logger = logging.getLogger()
    logger.setLevel(logging.DEBUG)
    if logger.hasHandlers():
        logger.handlers.clear()
    # File logging
    file_handler = logging.FileHandler(log_file_path, mode='w')
    file_handler.setLevel(logging.DEBUG)
    file_formatter = logging.Formatter(log_format_file)
    file_handler.setFormatter(file_formatter)
    logger.addHandler(file_handler)
    # Console logging
    console_handler = logging.StreamHandler(sys.stdout)
    console_handler.setLevel(log_level)
    color_formatter = ColorFormatter(log_format_console)
    color_formatter.handler = console_handler
    console_handler.setFormatter(color_formatter)
    logger.addHandler(console_handler)

def run_cmd(command, log_stdout=True):
    """Runs a command using subprocess and logs."""
    logging.debug(f"Running command: {command}")
    try:
        process = subprocess.run(command, shell=True, check=True,
                                 capture_output=True, text=True, encoding='utf-8', errors='ignore')
        if logging.getLogger().isEnabledFor(logging.DEBUG):
            if log_stdout and process.stdout:
                logging.debug("Command STDOUT:\n" + process.stdout.strip())
            if process.stderr:
                logging.debug("Command STDERR:\n" + process.stderr.strip())
        return process
    except subprocess.CalledProcessError as e:
        logging.error(f"Command failed with exit code {e.returncode}")
        logging.error(f"Failed command: {e.cmd}")
        stderr_output = e.stderr.strip() if e.stderr else "N/A"
        stdout_output = e.stdout.strip() if e.stdout else "N/A"
        logging.error(f"STDERR: {stderr_output}")
        if stdout_output != "N/A": logging.error(f"STDOUT: {stdout_output}")
        raise
    except FileNotFoundError as e:
        logging.error(f"Command not found: {command.split()[0]}")
        logging.error(f"Please ensure the required tools (like '{command.split()[0]}') are installed and in your PATH.")
        logging.error(f"Original error: {e}")
        raise

def generate_sample_list_from_fasta(input_fasta_path, output_list_path):
    """Generates sample list from FASTA headers."""
    logging.info(f"Extracting unique sample IDs from {input_fasta_path}...")
    uniquesampleids = set() # Use a set for faster uniqueness check
    processed_headers = 0
    try:
        with open(input_fasta_path, "r") as f_in:
            for line in f_in:
                if line.startswith(">"):
                    processed_headers += 1
                    try:
                        sampleid = line[1:].split("_", 1)[0]
                        if sampleid: uniquesampleids.add(sampleid)
                    except IndexError:
                        logging.warning(f"Could not parse sample ID from header (missing '_'?): {line.strip()}")
                        continue
        if not uniquesampleids:
             logging.warning("No unique sample IDs could be extracted from the input FASTA.")
             open(output_list_path, 'w').close()
             return False
        with open(output_list_path, "w") as f_out:
            # Sort IDs for consistent output order
            for sample_id in sorted(list(uniquesampleids)):
                f_out.write(sample_id + "\n")
        logging.info(f"Found {len(uniquesampleids)} unique sample IDs from {processed_headers} headers.")
        logging.info(f"Sample list written to {output_list_path}")
        return True
    except FileNotFoundError:
        logging.error(f"Input FASTA file not found: {input_fasta_path}")
        return False
    except IOError as e:
        logging.error(f"Error reading/writing file during sample list generation: {e}")
        return False
    except Exception as e:
        logging.error(f"An unexpected error occurred during sample list generation: {e}")
        return False

def reformat_rdp_taxonomy(input_file, output_file, confidence_threshold):
    """
    Re-formats RDP Classifier output to QIIME-compatible format.
    Args:
        input_file (str): Path to the raw RDP classifier output.
        output_file (str): Path to the output formatted file.
        confidence_threshold (float): Minimum confidence to retain a level.
    Returns:
        bool: True on success, False on failure.
    """
    logging.info(f"Reformatting RDP taxonomy from {input_file} (Threshold: {confidence_threshold})")
    PREFIX_MAP = {
        "domain": "d__", "kingdom": "k__", "phylum": "p__", "subphylum": "subp__",
        "class": "c__", "subclass": "subc__", "order": "o__", "family": "f__",
        "genus": "g__", "species": "s__"
    }
    try:
        with open(input_file, "r") as handle_input, open(output_file, "w") as handle_output:
            processed_lines = 0
            for line in handle_input:
                processed_lines += 1
                e = line.rstrip().split("\t")
                if len(e) < 8: # Need at least OTUID and one level
                    logging.warning(f"Skipping malformed line in RDP output: {line.strip()}")
                    continue

                otu_id = e[0]
                taxonomy = []
                taxonomy_conf = []

                # RDP output format: OTUID seq_len strand domain "Root" conf phylum "taxon" conf ...
                # Start parsing from index 5 (first rank name)
                for i in range(5, len(e), 3):
                    if (i + 2) >= len(e): # Check if triplet is complete
                        logging.warning(f"Incomplete taxonomy triplet for OTU {otu_id}, stopping parse for this OTU.")
                        break
                    tax_level = e[i+1].lower() # Lowercase level name for consistency
                    tax_name = e[i].replace(" ", "_") # Replace spaces in taxon name
                    try:
                        tax_confidence = float(e[i+2])
                    except ValueError:
                        logging.warning(f"Invalid confidence value '{e[i+2]}' for level '{tax_level}' in OTU {otu_id}. Skipping level.")
                        continue # Skip this level

                    prefix = PREFIX_MAP.get(tax_level)
                    if prefix:
                        taxonomy.append(f"{prefix}{tax_name}")
                        taxonomy_conf.append(tax_confidence)
                    else:
                        logging.warning(f"Unrecognized taxonomic level '{tax_level}' for OTU {otu_id}. Skipping.")

                # Filter based on confidence threshold
                taxonomy_filtered = []
                taxonomy_conf_filtered = []
                for i in range(len(taxonomy)):
                    if taxonomy_conf[i] >= confidence_threshold:
                        taxonomy_filtered.append(taxonomy[i])
                        taxonomy_conf_filtered.append(taxonomy_conf[i])
                    else:
                        break

                # Handle cases where nothing meets the threshold
                if not taxonomy_filtered:
                    final_taxonomy_str = "k__Unassigned" # Use 'k__' prefix for consistency
                    final_confidence = 1.0
                else:
                    final_taxonomy_str = "; ".join(taxonomy_filtered)
                    final_confidence = taxonomy_conf_filtered[-1] # Confidence of the last assigned level

                handle_output.write(f"{otu_id}\t{final_taxonomy_str}\t{final_confidence:.4f}\n")

        logging.info(f"Reformatted {processed_lines} lines. Output written to {output_file}")
        return True

    except FileNotFoundError:
        logging.error(f"Input RDP file not found: {input_file}")
        return False
    except IOError as e:
        logging.error(f"Error reading RDP file {input_file} or writing to {output_file}: {e}")
        return False
    except Exception as e:
        logging.error(f"An unexpected error occurred during RDP reformatting: {e}")
        logging.error(traceback.format_exc())
        return False


def reformat_sintax_taxonomy(input_file, output_file, confidence_threshold):
    """
    Re-formats VSEARCH SINTAX output to QIIME-compatible format.
    Args:
        input_file (str): Path to the raw SINTAX tabbed output.
        output_file (str): Path to the output formatted file.
        confidence_threshold (float): Minimum confidence to retain a level.
    Returns:
        bool: True on success, False on failure.
    """
    logging.info(f"Reformatting SINTAX taxonomy from {input_file} (Threshold: {confidence_threshold})")
    PREFIX_MAP = {"d": "d__", "k": "k__", "p": "p__", "c": "c__", "o": "o__", "f": "f__", "g": "g__", "s": "s__"}
    try:
        with open(input_file, "r") as handle_input, open(output_file, "w") as handle_output:
            processed_lines = 0
            for line in handle_input:
                processed_lines += 1
                parts = line.rstrip().split("\t")
                if not parts: continue # Skip empty lines

                otu_id = parts[0]
                raw_taxonomy_str = ""
                if len(parts) > 1:
                    raw_taxonomy_str = parts[1]

                taxonomy = []
                taxonomy_conf = []

                if raw_taxonomy_str:
                    tax_levels = raw_taxonomy_str.split(",")
                    for level_str in tax_levels:
                        try:
                            level_part, conf_part = level_str.split("(")
                            level_abbr = level_part.split(":")[0]
                            tax_name = level_part.split(":")[1].replace(" ", "_")
                            tax_confidence = float(conf_part.rstrip(")"))
                        except (ValueError, IndexError) as e:
                            logging.warning(f"Could not parse SINTAX level string '{level_str}' for OTU {otu_id}: {e}. Skipping level.")
                            continue

                        prefix = PREFIX_MAP.get(level_abbr)
                        if prefix and tax_name: # Ensure name is not empty
                            taxonomy.append(f"{prefix}{tax_name}")
                            taxonomy_conf.append(tax_confidence)
                        else:
                            logging.warning(f"Unrecognized SINTAX level '{level_abbr}' or empty name for OTU {otu_id}. Skipping.")

                # Filter based on confidence threshold
                taxonomy_filtered = []
                taxonomy_conf_filtered = []
                for i in range(len(taxonomy)):
                    if taxonomy_conf[i] >= confidence_threshold:
                        taxonomy_filtered.append(taxonomy[i])
                        taxonomy_conf_filtered.append(taxonomy_conf[i])
                    else:
                        break # Stop at the first level below threshold

                # Handle cases where nothing meets the threshold
                if not taxonomy_filtered:
                    final_taxonomy_str = "k__Unassigned"
                    final_confidence = 1.0
                else:
                    final_taxonomy_str = "; ".join(taxonomy_filtered)
                    final_confidence = taxonomy_conf_filtered[-1] # Confidence of last assigned level

                handle_output.write(f"{otu_id}\t{final_taxonomy_str}\t{final_confidence:.4f}\n")

        logging.info(f"Reformatted {processed_lines} lines. Output written to {output_file}")
        return True
    except FileNotFoundError:
        logging.error(f"Input SINTAX file not found: {input_file}")
        return False
    except IOError as e:
        logging.error(f"Error reading SINTAX file {input_file} or writing to {output_file}: {e}")
        return False
    except Exception as e:
        logging.error(f"An unexpected error occurred during SINTAX reformatting: {e}")
        logging.error(traceback.format_exc())
        return False


def create_phylotype_table(input_biom_file, output_tsv_file, level):
    """
    Collapses a BIOM table to a specified taxonomic level and writes to TSV.
    Args:
        input_biom_file (str): Path to the input BIOM table file.
        output_tsv_file (str): Path to the output TSV phylotype table.
        level (int): Taxonomic level index (0=domain/kingdom, 1=phylum, ..., 6=species).
    Returns:
        bool: True on success, False on failure.
    """
    logging.info(f"Creating phylotype table (Level index: {level}) from {input_biom_file}")
    try:
        biom_table = load_table(input_biom_file)
        phylum_idx = int(level)
        slice_end = phylum_idx + 1

        def collapse_fn(id_, md):
            taxonomy_list = md.get('taxonomy') # Use .get for safety
            if taxonomy_list and isinstance(taxonomy_list, (list, tuple)) and len(taxonomy_list) > phylum_idx:
                 return '; '.join(taxonomy_list[:slice_end])
            elif taxonomy_list and isinstance(taxonomy_list, (list, tuple)):
                 logging.debug(f"Taxonomy for {id_} is shorter than requested level {level}. Using full path: {taxonomy_list}")
                 return '; '.join(taxonomy_list)
            else:
                 logging.warning(f"No taxonomy metadata found for OTU ID: {id_}. Collapsing to 'Unassigned'.")
                 return 'k__Unassigned'

        logging.debug(f"Collapsing BIOM table observations using slice end index: {slice_end}")
        collapsed_table = biom_table.collapse(collapse_fn, norm=False, min_group_size=1, axis='observation').sort(axis='observation')

        with open(output_tsv_file, "w") as outfile:
            outfile.write(collapsed_table.to_tsv())

        logging.info(f"Phylotype table (Level {level}) written to {output_tsv_file}")
        return True

    except FileNotFoundError:
        logging.error(f"Input BIOM file not found: {input_biom_file}")
        return False
    except (IOError, ValueError) as e:
        logging.error(f"Error processing BIOM file {input_biom_file} or writing TSV {output_tsv_file}: {e}")
        return False
    except KeyError as e:
         logging.error(f"Metadata key error during collapse (likely missing 'taxonomy' metadata in BIOM file {input_biom_file}): {e}")
         return False
    except Exception as e:
        logging.error(f"An unexpected error occurred during phylotyping: {e}")
        logging.error(traceback.format_exc())
        return False

def create_otu_table_from_uc(uc_file_path, sample_list_path, output_tsv_path):
    """
    Generates an OTU table (TSV format) from a VSEARCH .uc file (expected from
    --usearch_global, i.e., primarily 'H' and 'N' lines) and a sample list.
    Replicates the functionality of the original pipits_uc2otutable.py script,
    but optimized for --usearch_global output (ignores 'S' lines).

    Args:
        uc_file_path (str): Path to the input .uc file.
        sample_list_path (str): Path to the file containing sample IDs (one per line).
        output_tsv_path (str): Path to write the output OTU table TSV file.

    Returns:
        bool: True on success, False on failure.
    """
    logging.info(f"Generating OTU table from UC file: {uc_file_path}")
    otus = {} # Key: OTU_ID (target), Value: List of sample IDs from reads hitting this OTU
    line_count = 0
    processed_hits = 0

    try:
        # --- Process UC file ---
        with open(uc_file_path, "r") as infile:
            for line in infile:
                line = line.rstrip()
                if not line or line.startswith('#'): continue # Skip empty/comment lines

                line_count += 1
                fields = line.split("\t")

                # Expect 'H' (Hit) or 'N' (No Hit) lines from --usearch_global
                # We only care about Hits ('H') for building the table
                if fields[0] != 'H':
                    continue # Skip non-hit lines (like 'N')

                if len(fields) < 10:
                    logging.error(f"Hit line {line_count} in .uc file '{uc_file_path}' has < 10 fields. Skipping.")
                    continue

                # Field 8: Query label (Read ID)
                # Field 9: Target label (OTU ID)
                read_id = fields[8]
                otu_id_target = fields[9]

                # Extract sample ID from read ID (part before the first '_')
                try:
                    sample_id = read_id.split("_", 1)[0]
                except IndexError:
                    logging.warning(f"Could not parse sample ID from read ID '{read_id}' on hit line {line_count}. Skipping read.")
                    continue

                # If this is the first time we see this OTU_ID, initialize its list
                if otu_id_target not in otus:
                    otus[otu_id_target] = []

                # Append the sample ID associated with this read to the OTU's list
                otus[otu_id_target].append(sample_id)
                processed_hits += 1

        logging.debug(f"Processed {line_count} lines from {uc_file_path}.")
        logging.debug(f"Found {processed_hits} hits mapping to {len(otus)} OTUs.")

        if not otus:
             logging.warning(f"No hits ('H' lines) were processed from the UC file: {uc_file_path}. The resulting OTU table will be empty.")
             # Create an empty file with header to avoid downstream errors?
             # Let's proceed and let the write step handle the empty dict

        # --- Load Sample IDs ---
        sample_ids_list = []
        with open(sample_list_path, "r") as samplefile:
            for line in samplefile:
                line = line.strip()
                if line and not line.startswith("#"):
                    sample_ids_list.append(line.split("\t")[0]) # Take first part if tab-separated

        if not sample_ids_list:
            logging.error(f"No sample IDs loaded from sample list file: {sample_list_path}")
            return False
        logging.info(f"Loaded {len(sample_ids_list)} sample IDs from {sample_list_path}.")

        # --- Write OTU Table ---
        with open(output_tsv_path, "w") as outfile:
            # Write header
            outfile.write("#OTU_ID\t" + "\t".join(sample_ids_list) + "\n")

            # Write OTU counts per sample
            final_otu_count = 0
            # Sort OTU IDs for consistent output order
            for otu_id in sorted(otus.keys()):
                member_reads_samples = otus[otu_id]
                final_otu_count += 1
                outfile.write(otu_id)
                total_reads_for_otu = 0
                for sample_id in sample_ids_list:
                    count = member_reads_samples.count(sample_id)
                    outfile.write("\t" + str(count))
                    total_reads_for_otu += count

                # Sanity check (optional)
                if len(member_reads_samples) != total_reads_for_otu:
                    logging.warning(f"Mismatch in read count for OTU {otu_id}. Internal list length: {len(member_reads_samples)}, Summed count: {total_reads_for_otu}.")

                outfile.write("\n")

        if final_otu_count == 0 and processed_hits > 0:
             logging.warning(f"Processed {processed_hits} hits but wrote 0 OTUs to the table. This might indicate an issue with OTU IDs or the writing process.")
        elif final_otu_count == 0 and processed_hits == 0:
             logging.info(f"No hits found in UC file, an empty OTU table was written to {output_tsv_path}")
        else:
             logging.info(f"OTU table with {final_otu_count} OTUs written to {output_tsv_path}")
        return True

    except FileNotFoundError as e:
        logging.error(f"File not found during OTU table generation: {e}")
        return False
    except IOError as e:
        logging.error(f"I/O error during OTU table generation: {e}")
        return False
    except Exception as e:
        logging.error(f"An unexpected error occurred during OTU table generation: {e}")
        logging.error(traceback.format_exc())
        return False

