        default = "19.02.2025",
        required = False)
    parser.add_argument(
        "--ignore-db-download",
        action = "store_true",
        dest = "ignore_db_download",
        default = False,
        help = "Ignore automatic download of database files. Assumes databases are already present in 'pipits_db/'.",
        required = False)

    options = parser.parse_args()


    # --- Directory Setup ---
    if not os.path.exists(options.outDir):
        os.makedirs(options.outDir)

    tmpDir = os.path.join(options.outDir, "intermediate")
    if not os.path.exists(tmpDir):
        os.makedirs(tmpDir)


    # --- Logging Setup ---
    log_file = os.path.join(options.outDir, "output.log")
    summary_file_path = os.path.join(options.outDir, "summary.log")
    version_file_path = os.path.join(options.outDir, "versions.log")

    setup_logging(log_file, options.verbose)

    # --- Start! ---
    logging.info(f"pipits_process {__version__}, the PIPITS Project")
    logging.info("https://github.com/hsgweon/pipits")
    logging.info("---------------------------------")
    logging.info("")

    # --- Log versions ---
    try:
        cmd_versions = "conda list"
        version_info = run_cmd(cmd_versions, log_stdout=False)
        with open(version_file_path, "w") as vf:
            vf.write(f"Command: {cmd_versions}\n")
            vf.write(version_info.stdout)
        logging.info(f"Environment details logged to {version_file_path}")
    except Exception as e:
        logging.warning(f"Could not log environment versions using conda: {e}")

    # --- Start Processing ---
    logging.info("pipits_process started")
    start_time = time.time()


    # --- Input Validation ---
    if not os.path.exists(options.input):
        logging.error(f"Input file not found: {options.input}")
        sys.exit(1)

    if os.stat(options.input).st_size == 0:
        logging.error("Input file is empty!")
        sys.exit(0)


    # --- Sample ID Handling ---
    if not options.sortedlist:
        logging.info("Sample list (-l) not provided. Generating from input FASTA headers...")
        generated_sample_list_path = os.path.join(options.outDir, "generated_sampleIDs.txt")
        try:
            success = generate_sample_list_from_fasta(options.input, generated_sample_list_path)
            if not success:
                 logging.error("Failed to generate sample list automatically.")
                 sys.exit(1)
            options.sortedlist = generated_sample_list_path
        except Exception as e:
             logging.error(f"An unexpected error occurred calling generate_sample_list_from_fasta: {e}")
             sys.exit(1)
    else:
        logging.info(f"Using provided sample list: {options.sortedlist}")


    sampleIDs_check = []
    if not os.path.exists(options.sortedlist):
        logging.error(f"Sample list file does NOT exist: {options.sortedlist}")
        sys.exit(1)

    try:
        with open(options.sortedlist, 'r') as f_list:
            for line in f_list:
                line_content = line.strip()
                if line_content and not line_content.startswith("#"):
                    if ' ' in line_content:
                         logging.warning(f"Space detected in sample ID '{line_content}' from list file {options.sortedlist}. Consider removing spaces.")
                    sampleIDs_check.append(line_content.split("\t")[0])
    except IOError as e:
         logging.error(f"Could not read sample list file {options.sortedlist}: {e}")
         sys.exit(1)

    if not sampleIDs_check:
        logging.error(f"No valid sample IDs found in the sample list file: {options.sortedlist}")
        sys.exit(1)
    logging.info(f"Checked {len(sampleIDs_check)} sample IDs from {options.sortedlist}.")


    # Check for duplicate entries
    duplicateIDs = list(set([x for x in sampleIDs_check if sampleIDs_check.count(x) > 1]))
    if len(duplicateIDs) > 0:
        logging.error("You have duplicate id(s) in your Sample list file. Offending id(s): " + ",".join(duplicateIDs))
        sys.exit(1)


    # --- Download Data Section ---

    def get_md5(filename):
        hash_md5 = hashlib.md5()
        try:
            with open(filename, "rb") as f:
                for chunk in iter(lambda: f.read(4096), b""): hash_md5.update(chunk)
            return hash_md5.hexdigest()
        except FileNotFoundError:
            logging.error(f"File not found for MD5 calculation: {filename}"); return None
        except IOError as e:
            logging.error(f"Could not read file for MD5 calculation {filename}: {e}"); return None

    def downloadDB(url, md5, output_dir):
        if not os.path.exists(output_dir):
            try: os.makedirs(output_dir)
            except OSError as e: logging.error(f"Could not create DB dir {output_dir}: {e}"); raise
        filename = url.split("/")[-1]
        filepath = os.path.join(output_dir, filename)
        unpacked_dirname = os.path.join(output_dir, filename.split(".tar.gz")[0])
        DOWNLOADDB = True
        if os.path.isdir(unpacked_dirname) and len(os.listdir(unpacked_dirname)) > 0:
            logging.info(f"Found existing unpacked dir: {unpacked_dirname}. Assuming DB present."); DOWNLOADDB = False
        elif os.path.isfile(filepath):
            existing_md5 = get_md5(filepath)
            if existing_md5 and existing_md5 == md5:
                logging.info(f"Found archive: {filepath} with matching MD5. Will unpack."); DOWNLOADDB = False
            else:
                logging.warning(f"Archive {filepath} MD5 mismatch/corrupt -> re-downloading...");
                try: os.remove(filepath);
                except OSError as e: logging.warning(f"Could not remove old file: {e}")
                if os.path.exists(unpacked_dirname): shutil.rmtree(unpacked_dirname)
                DOWNLOADDB = True
        else: logging.info(f"Archive/unpacked dir not found. Downloading."); DOWNLOADDB = True
        if DOWNLOADDB:
            logging.info(f"Downloading {filename} from {url}")
            try: request = requests.get(url, stream=True, timeout=60); request.raise_for_status()
            except requests.exceptions.RequestException as e: logging.error(f"Download failed {url}: {e}"); raise
            try:
                with open(filepath, 'wb') as file:
                    file_size = int(request.headers.get('Content-Length', 0)); file_size_mb = round(file_size / 1024 / 1024, 2) if file_size > 0 else 0
                    widgets = [progressbar.Bar(), progressbar.Percentage(), " | ", progressbar.FileTransferSpeed(), " | ", progressbar.DataSize(), f" / {file_size_mb:.2f} MB | " if file_size_mb > 0 else " | ", progressbar.ETA()]
                    bar = progressbar.ProgressBar(widgets=widgets, max_value=file_size or progressbar.UnknownLength).start(); i = 0
                    for chunk in request.iter_content(chunk_size=8192):
                        if chunk: file.write(chunk); i += len(chunk); bar.update(i)
                    bar.finish()
            except IOError as e: logging.error(f"Could not write downloaded file {filepath}: {e}"); raise
            except Exception as e: logging.error(f"Unexpected download error: {e}"); raise
            downloaded_md5 = get_md5(filepath)
            if not downloaded_md5 or downloaded_md5 != md5: logging.error(f"Downloaded {filepath} corrupt/MD5 mismatch. Exiting."); sys.exit(1)
            else: logging.info("Download successful and verified.")
        if os.path.isfile(filepath) and not (os.path.isdir(unpacked_dirname) and len(os.listdir(unpacked_dirname)) > 0):
            logging.info(f"Unpacking {filepath}")
            if os.path.exists(unpacked_dirname):
                try: shutil.rmtree(unpacked_dirname)
                except OSError as e: logging.error(f"Could not remove existing unpacked dir {unpacked_dirname}: {e}"); raise
            try: os.makedirs(unpacked_dirname)
            except OSError as e: logging.error(f"Could not create unpack dir {unpacked_dirname}: {e}"); raise
            try:
                with tarfile.open(filepath, "r:gz") as tar: tar.extractall(path=unpacked_dirname)
                logging.info("Unpacking complete.")
            except tarfile.ReadError as e: logging.error(f"Failed to unpack {filepath}. Corrupt? Error: {e}"); sys.exit(1)
            except Exception as e: logging.error(f"Unexpected unpack error: {e}"); sys.exit(1)
        elif not os.path.isdir(unpacked_dirname) or len(os.listdir(unpacked_dirname)) == 0:
            logging.error(f"DB download skipped, but required unpacked dir '{unpacked_dirname}' missing/empty."); sys.exit(1)

    # --- Conditional Download Execution ---
    if options.ignore_db_download:
        logging.warning("Skipping DB downloads (--ignore-db-download).")
        logging.warning("Ensure required DBs are present in 'pipits_db/'.")
        DB_DIR = "pipits_db"
        if not os.path.isdir(DB_DIR): logging.error(f"DB download skipped, but DB dir '{DB_DIR}' not found."); sys.exit(1)
    else:
        DB_DOWNLOAD_ERROR = False
        # UNITE RDP
        if options.taxassignmentmethod == "all" or options.taxassignmentmethod == "rdp":
            logging.info(f"Checking/Downloading UNITE RDP DB, version: {options.unite}")
            url = f"https://sourceforge.net/projects/pipits/files/PIPITS_DB/UNITE_retrained_{options.unite}.tar.gz"
            md5_map_rdp = {"19.02.2025": "1d5b1fdab5b173618c912c08835958f8",
                           "04.04.2024": "94812f45cbfed846b55a6e845e68f35f",
                           "25.07.2023": "1c578d0aba436f0b66d9a73b2991086d",
                           "27.10.2022": "7d31f5612a78607e50d4170b75d0cbfa",
                           "10.05.2021": "13f1edfb1357eeda3f41ff8b0a15447f",
                           "04.02.2020": "b2f833c89794be20a5fdb6169d9205f1",
                           "02.02.2019": "8fd3b74a510bb20b67933a2ecc620f89",
                           "01.12.2017": "3c5be9c60fecf70076739379e7c9ead5",
                           "28.06.2017": "33fa78987751a494c586676ff3a0da65"}
            md5 = md5_map_rdp.get(options.unite)
            if not md5: logging.error(f"Unknown MD5 for UNITE RDP {options.unite}. Cannot verify."); DB_DOWNLOAD_ERROR = True
            else:
                try: downloadDB(url=url, md5=md5, output_dir="pipits_db")
                except Exception as e: logging.error(f"Failed UNITE RDP DB download/process: {e}"); DB_DOWNLOAD_ERROR = True
        # SINTAX
        if not DB_DOWNLOAD_ERROR and (options.taxassignmentmethod == "all" or options.taxassignmentmethod == "sin"):
            logging.info(f"Checking/Downloading UNITE SINTAX DB, version: {options.unite}")
            url = f"https://sourceforge.net/projects/pipits/files/PIPITS_DB/UNITE_retrained_{options.unite}.sintax.fa.tar.gz"
            md5_map_sintax = {"19.02.2025": "bb6a7d9d16d6d60484d62d55fdd6dc55",
                              "04.04.2024": "135cce3029569c1c0528a7fdd9ed6673",
                              "25.07.2023": "cf7dcd5e289a4d31c87fadb056caaca7",
                              "27.10.2022": "b26ebd07a5abb415e1ad35b8dc8108d2"}
            md5 = md5_map_sintax.get(options.unite)
            if not md5: logging.error(f"Unknown MD5 for UNITE SINTAX {options.unite}. Cannot verify."); DB_DOWNLOAD_ERROR = True
            else:
                try: downloadDB(url=url, md5=md5, output_dir="pipits_db")
                except Exception as e: logging.error(f"Failed UNITE SINTAX DB download/process: {e}"); DB_DOWNLOAD_ERROR = True
        # UCHIME
        if not DB_DOWNLOAD_ERROR:
            logging.info("Checking/Downloading UCHIME DB")
            url = "https://sourceforge.net/projects/pipits/files/PIPITS_DB/uchime_reference_dataset_28.06.2017.tar.gz"
            md5 = "a84af781f9ba42a76f456b558dbc1ae5"
            try: downloadDB(url=url, md5=md5, output_dir="pipits_db")
            except Exception as e: logging.error(f"Failed UCHIME DB download/process: {e}"); DB_DOWNLOAD_ERROR = True
        if DB_DOWNLOAD_ERROR: logging.critical("DB download failed. Exiting."); sys.exit(1)

    # --- Define DB Paths and Check Existence ---
    DB_DIR = "pipits_db"
    UCHIME_DB_NAME = "uchime_reference_dataset_28.06.2017"
    UCHIME_DB_PATH = os.path.join(DB_DIR, UCHIME_DB_NAME, f"{UCHIME_DB_NAME}.fasta")
    RDP_UNITE_DB_NAME = f"UNITE_retrained_{options.unite}"
    PIPITS_UNITE_RETRAINED_PROPERTIES = os.path.join(DB_DIR, RDP_UNITE_DB_NAME, "UNITE_retrained", "rRNAClassifier.properties")
    SINTAX_UNITE_DB_NAME = f"UNITE_retrained_{options.unite}.sintax.fa"
    PIPITS_UNITE_RETRAINED_VSEARCHSINTAXFORMATTED = os.path.join(DB_DIR, SINTAX_UNITE_DB_NAME, f"UNITE_retrained_{options.unite}.sintax.fa")
    DB_MISSING_ERROR = False
    if not os.path.isfile(UCHIME_DB_PATH): logging.error(f"UCHIME DB not found: {UCHIME_DB_PATH}"); DB_MISSING_ERROR = True
    if options.taxassignmentmethod == "all" or options.taxassignmentmethod == "rdp":
        if not os.path.isfile(PIPITS_UNITE_RETRAINED_PROPERTIES): logging.error(f"RDP properties not found: {PIPITS_UNITE_RETRAINED_PROPERTIES}"); DB_MISSING_ERROR = True
    if options.taxassignmentmethod == "all" or options.taxassignmentmethod == "sin":
        if not os.path.isfile(PIPITS_UNITE_RETRAINED_VSEARCHSINTAXFORMATTED): logging.error(f"SINTAX DB not found: {PIPITS_UNITE_RETRAINED_VSEARCHSINTAXFORMATTED}"); DB_MISSING_ERROR = True
    if DB_MISSING_ERROR: logging.critical("Required DB files missing. Exiting."); sys.exit(1)
    else: logging.info("Required database files check passed.")

    # --- Main Processing Steps ---
    try:
        # Derep
        minuniquesize = 2 if not options.includeuniqueseqs else 1
        logging.info("Dereplicating unique sequences [VSEARCH]")
        input_nr_fasta = os.path.join(tmpDir, "input_nr.fasta")
        cmd = f"{VSEARCH} --derep_fulllength \"{options.input}\" --output \"{input_nr_fasta}\" --minuniquesize {minuniquesize} --sizeout --fasta_width 0"
        run_cmd(cmd)
        if not os.path.exists(input_nr_fasta) or os.stat(input_nr_fasta).st_size == 0:
            logging.error("Dereplication produced no sequences. Exiting."); sys.exit(0)

        # OTU clustering
        logging.info(f"Clustering OTUs at {options.VSEARCH_id} identity [VSEARCH]")
        input_nr_otus_fasta = os.path.join(tmpDir, "input_nr_otus.fasta")
        input_nr_otus_uc = os.path.join(tmpDir, "input_nr_otus.uc")
        cmd = f"{VSEARCH} --cluster_fast \"{input_nr_fasta}\" --id {options.VSEARCH_id} --centroids \"{input_nr_otus_fasta}\" --uc \"{input_nr_otus_uc}\" --threads {options.threads} --fasta_width 0"
        run_cmd(cmd)

        # Chimera removal
        logging.info("Removing chimeras using UCHIME-ref [VSEARCH]")
        input_nr_otus_nonchimeras_fasta = os.path.join(tmpDir, "input_nr_otus_nonchimeras.fasta")
        cmd = f"{VSEARCH} --uchime_ref \"{input_nr_otus_fasta}\" --db \"{UCHIME_DB_PATH}\" --nonchimeras \"{input_nr_otus_nonchimeras_fasta}\" --threads {options.threads} --fasta_width 0"
        run_cmd(cmd)

        # Rename OTUs
        logging.info("Renaming OTUs")
        renamed_otus_fasta = os.path.join(tmpDir, "input_nr_otus_nonchimeras_relabelled.fasta")
        try:
            with open(input_nr_otus_nonchimeras_fasta, "r") as handle_in, open(renamed_otus_fasta, "w") as handle_out:
                counter = 1; header_found = False
                for line in handle_in:
                    if line.startswith(">"): handle_out.write(f">OTU{counter}\n"); counter += 1; header_found = True
                    else: handle_out.write(line)
            if not header_found:
                 logging.warning("No non-chimeric OTU sequences found after chimera removal.")
        except IOError as e: logging.error(f"OTU renaming failed: {e}"); raise

        if not os.path.exists(renamed_otus_fasta) or os.stat(renamed_otus_fasta).st_size == 0:
            logging.warning("No non-chimeric OTUs to process further. Exiting pipeline.")
            if not options.retain:
                logging.info("Cleaning temporary directory")
                try: shutil.rmtree(tmpDir)
                except OSError as e: logging.warning(f"Could not remove temp dir {tmpDir}: {e}")
            sys.exit(0)

        # Map reads to OTUs
        logging.info("Mapping original reads to OTU centroids [VSEARCH]")
        otus_uc_path = os.path.join(tmpDir, "otus.uc")
        cmd = f"{VSEARCH} --usearch_global \"{options.input}\" --db \"{renamed_otus_fasta}\" --id {options.VSEARCH_id} --uc \"{otus_uc_path}\" --threads {options.threads}"
        run_cmd(cmd)

        # --- INTEGRATED OTU TABLE CONSTRUCTION ---
        logging.info("Generating OTU table from mapping file [Internal Function]")
        otu_table_prelim_txt = os.path.join(tmpDir, "otu_table_prelim.txt")
        success = create_otu_table_from_uc(uc_file_path=otus_uc_path,
                                           sample_list_path=options.sortedlist,
                                           output_tsv_path=otu_table_prelim_txt)
        if not success:
            raise RuntimeError("Failed to generate OTU table using integrated function.")
        # --- END INTEGRATED CALL ---

        # Convert to biom
        logging.info("Converting OTU table to BIOM format [BIOM]")
        otu_table_prelim_biom = os.path.join(tmpDir, "otu_table_prelim.biom")
        try: os.remove(otu_table_prelim_biom)
        except OSError: pass
        # Check if prelim table is empty before converting
        if os.path.exists(otu_table_prelim_txt) and os.stat(otu_table_prelim_txt).st_size > 0:
             # Check if it only contains the header
            with open(otu_table_prelim_txt, 'r') as f_check:
                if len(f_check.readlines()) <= 1: # Only header or empty
                     logging.warning(f"Preliminary OTU table '{otu_table_prelim_txt}' is empty or contains only header. Skipping BIOM conversion and downstream steps.")
                     # Exit gracefully after cleanup? Or continue to allow summary? Let's continue for now.
                     # Set a flag or check file existence later
                     otu_table_prelim_biom = None # Indicate no BIOM file created
                else:
                    cmd = f"{BIOM} convert -i \"{otu_table_prelim_txt}\" -o \"{otu_table_prelim_biom}\" --table-type=\"OTU table\" --to-hdf5"
                    run_cmd(cmd)
        else:
            logging.warning(f"Preliminary OTU table '{otu_table_prelim_txt}' not found or is empty. Skipping BIOM conversion and downstream steps.")
            otu_table_prelim_biom = None # Indicate no BIOM file created


        # --- Downstream steps only if otu_table_prelim_biom was created ---
        if otu_table_prelim_biom and os.path.exists(otu_table_prelim_biom):

            # --- VSINTAX ---
            if options.taxassignmentmethod == "all" or options.taxassignmentmethod == "sin":
                logging.info("Assigning taxonomy with VSEARCH-SINTAX")
                sintax_raw_txt = os.path.join(options.outDir, "assigned_taxonomy_sintax_raw.txt")
                cmd = f"{VSEARCH} --sintax \"{renamed_otus_fasta}\" --db \"{PIPITS_UNITE_RETRAINED_VSEARCHSINTAXFORMATTED}\" --sintax_cutoff {options.sintaxconfidence} --tabbedout \"{sintax_raw_txt}\" --threads {options.threads}"
                run_cmd(cmd)

                logging.info("Reformatting SINTAX output")
                sintax_reformatted_txt = os.path.join(options.outDir, "assigned_taxonomy_sintax.txt")
                success = reformat_sintax_taxonomy(sintax_raw_txt, sintax_reformatted_txt, options.sintaxconfidence)
                if not success: raise RuntimeError("SINTAX reformatting failed.")

                logging.info("Adding SINTAX assignment to BIOM table")
                otu_table_sintax_biom = os.path.join(options.outDir, "otu_table_sintax.biom")
                try: os.remove(otu_table_sintax_biom)
                except OSError: pass
                cmd = f"{BIOM} add-metadata -i \"{otu_table_prelim_biom}\" -o \"{otu_table_sintax_biom}\" --observation-metadata-fp \"{sintax_reformatted_txt}\" --observation-header OTUID,taxonomy,confidence --sc-separated taxonomy --float-fields confidence"
                run_cmd(cmd)

                logging.info("Converting SINTAX BIOM table to TSV format")
                otu_table_sintax_txt = os.path.join(options.outDir, "otu_table_sintax.txt")
                try: os.remove(otu_table_sintax_txt)
                except OSError: pass
                cmd = f"{BIOM} convert -i \"{otu_table_sintax_biom}\" -o \"{otu_table_sintax_txt}\" --to-tsv --header-key taxonomy"
                run_cmd(cmd)

                logging.info("Generating SINTAX phylotype table (Level 6)")
                phylotype_sintax_txt = os.path.join(options.outDir, "phylotype_table_sintax.txt")
                phylotype_level = 6
                success = create_phylotype_table(otu_table_sintax_biom, phylotype_sintax_txt, phylotype_level)
                if not success: raise RuntimeError("SINTAX Phylotyping failed.")

                phylotype_sintax_biom = os.path.join(options.outDir, "phylotype_table_sintax.biom")
                try: os.remove(phylotype_sintax_biom)
                except OSError: pass
                cmd = f"{BIOM} convert -i \"{phylotype_sintax_txt}\" -o \"{phylotype_sintax_biom}\" --table-type=\"OTU table\" --to-hdf5"
                run_cmd(cmd)

            # --- RDP ---
            if options.taxassignmentmethod == "all" or options.taxassignmentmethod == "rdp":
                logging.info("Assigning taxonomy with RDP Classifier")
                rdp_raw_txt = os.path.join(options.outDir, "assigned_taxonomy_rdp_raw.txt")
                if not shutil.which("classifier"):
                     logging.error("RDP Classifier command 'classifier' not found in PATH. Cannot proceed with RDP assignment.")
                     raise FileNotFoundError("classifier command not found")
                cmd = f"classifier -Xms{options.Xms} -Xmx{options.Xmx} classify -c {options.RDP_assignment_threshold} -t \"{PIPITS_UNITE_RETRAINED_PROPERTIES}\" -o \"{rdp_raw_txt}\" \"{renamed_otus_fasta}\""
                run_cmd(cmd)

                logging.info("Reformatting RDP output")
                rdp_reformatted_txt = os.path.join(options.outDir, "assigned_taxonomy_rdp.txt")
                success = reformat_rdp_taxonomy(rdp_raw_txt, rdp_reformatted_txt, options.RDP_assignment_threshold)
                if not success: raise RuntimeError("RDP reformatting failed.")

                logging.info("Adding RDP assignment to BIOM table")
                otu_table_rdp_biom = os.path.join(options.outDir, "otu_table_rdp.biom")
                try: os.remove(otu_table_rdp_biom)
                except OSError: pass
                cmd = f"{BIOM} add-metadata -i \"{otu_table_prelim_biom}\" -o \"{otu_table_rdp_biom}\" --observation-metadata-fp \"{rdp_reformatted_txt}\" --observation-header OTUID,taxonomy,confidence --sc-separated taxonomy --float-fields confidence"
                run_cmd(cmd)

                logging.info("Converting RDP BIOM table to TSV format")
                otu_table_rdp_txt = os.path.join(options.outDir, "otu_table_rdp.txt")
                try: os.remove(otu_table_rdp_txt)
                except OSError: pass
                cmd = f"{BIOM} convert -i \"{otu_table_rdp_biom}\" -o \"{otu_table_rdp_txt}\" --to-tsv --header-key taxonomy"
                run_cmd(cmd)

                logging.info("Generating RDP phylotype table (Level 6)")
                phylotype_rdp_txt = os.path.join(options.outDir, "phylotype_table_rdp.txt")
                phylotype_level = 6
                success = create_phylotype_table(otu_table_rdp_biom, phylotype_rdp_txt, phylotype_level)
                if not success: raise RuntimeError("RDP Phylotyping failed.")

                phylotype_rdp_biom = os.path.join(options.outDir, "phylotype_table_rdp.biom")
                try: os.remove(phylotype_rdp_biom)
                except OSError: pass
                cmd = f"{BIOM} convert -i \"{phylotype_rdp_txt}\" -o \"{phylotype_rdp_biom}\" --table-type=\"OTU table\" --to-hdf5"
                run_cmd(cmd)

        # --- End of conditional downstream steps ---
        else:
             logging.warning("Skipping taxonomy assignment and phylotyping because the preliminary BIOM table was not generated (likely due to no reads mapping).")


        # Move representative sequence file to outDir (always do this if it exists)
        if os.path.exists(renamed_otus_fasta):
             final_repseq_path = os.path.join(options.outDir, "repseqs.fasta")
             logging.info(f"Moving final representative sequences to {final_repseq_path}")
             # Use copy then remove for robustness across filesystems, or just move
             try:
                 shutil.move(renamed_otus_fasta, final_repseq_path)
             except Exception as e:
                 logging.warning(f"Could not move representative sequences: {e}")
                 # Try copying if move failed? Optional.
                 # try:
                 #     shutil.copy2(renamed_otus_fasta, final_repseq_path)
                 #     os.remove(renamed_otus_fasta)
                 # except Exception as ec:
                 #     logging.error(f"Could not copy representative sequences either: {ec}")


    # --- End of Main Processing Try/Except Block ---
    except (subprocess.CalledProcessError, FileNotFoundError, IOError, ImportError, RuntimeError) as e:
         logging.critical(f"A critical error occurred during processing: {e}")
         logging.critical("Pipeline execution halted.")
         sys.exit(1)
    except Exception as e:
         logging.critical(f"An unexpected critical error occurred: {e}")
         logging.error(traceback.format_exc())
         logging.critical("Pipeline execution halted.")
         sys.exit(1)


    # --- Cleanup ---
    if not options.retain:
        logging.info("Cleaning temporary directory")
        try: shutil.rmtree(tmpDir); logging.info("... temporary directory removed.")
        except OSError as e: logging.warning(f"Could not remove temp dir {tmpDir}: {e}")
    else: logging.info(f"Intermediate files retained in: {tmpDir}")


    # --- Stats Calculation ---
    def biomstats(BIOMFILE):
        try:
            biom_table = load_table(BIOMFILE)
            sampleSize = int(biom_table.shape[1]); otus = int(biom_table.shape[0]); totalCount = biom_table.sum()
            return totalCount, otus, sampleSize
        except ImportError: logging.warning("'biom-format' missing. Cannot calc stats."); return "N/A", "N/A", "N/A"
        except FileNotFoundError: logging.warning(f"BIOM file not found for stats: {BIOMFILE}"); return "NF", "NF", "NF"
        except Exception as e: logging.warning(f"Cannot process BIOM {BIOMFILE} for stats: {e}"); return "Err", "Err", "Err"

    final_otu_biom_path = ""; stats_method = ""
    potential_sintax_otu = os.path.join(options.outDir, "otu_table_sintax.biom")
    potential_rdp_otu = os.path.join(options.outDir, "otu_table_rdp.biom")

    # Check if the final BIOM files *exist* before trying to calculate stats
    if (options.taxassignmentmethod == "all" or options.taxassignmentmethod == "sin") and os.path.exists(potential_sintax_otu):
        final_otu_biom_path = potential_sintax_otu; stats_method = "SINTAX"
    elif (options.taxassignmentmethod == "all" or options.taxassignmentmethod == "rdp") and os.path.exists(potential_rdp_otu):
        final_otu_biom_path = potential_rdp_otu; stats_method = "RDP"
    # Add a fallback if no final tax-assigned table exists but the prelim one might
    elif otu_table_prelim_biom and os.path.exists(otu_table_prelim_biom) and not final_otu_biom_path:
         logging.warning("No final taxonomy-assigned BIOM table found. Using preliminary BIOM for stats.")
         final_otu_biom_path = otu_table_prelim_biom
         stats_method = "Preliminary (No Taxonomy)"


    otu_reads_count, otu_count, otu_sample_count = "N/A", "N/A", "N/A"
    if final_otu_biom_path and os.path.exists(final_otu_biom_path): # Double check existence
        logging.info(f"Calculating summary stats from final BIOM table: {final_otu_biom_path}")
        otu_reads_count, otu_count, otu_sample_count = biomstats(final_otu_biom_path)
    elif otu_table_prelim_biom is None:
         logging.warning("Could not calculate stats because no preliminary or final BIOM file was generated (likely no reads mapped).")
    else:
        logging.warning(f"Could not find a suitable final OTU BIOM file ({potential_sintax_otu} or {potential_rdp_otu}) for summary stats.")


    # --- Write Summary File ---
    summary_lines = [
        "--- PIPITS_PROCESS Summary ---",
        f"Final stats based on table:           {stats_method}",
        f"No. of reads in final OTU table:      {int(otu_reads_count) if isinstance(otu_reads_count, (int, float)) and otu_reads_count != 'N/A' else otu_reads_count}", # Handle N/A for int conversion
        f"Number of OTUs:                       {otu_count}",
        f"Number of samples:                    {otu_sample_count}",
        "",
        f"UNITE DB version used:                {options.unite}",
        f"Taxonomy Assignment Method chosen:    {options.taxassignmentmethod}",
        f"Identity Threshold (VSEARCH):         {options.VSEARCH_id}",
        f"RDP Confidence Threshold:             {options.RDP_assignment_threshold}",
        f"SINTAX Confidence Threshold:          {options.sintaxconfidence}",
        f"Included Singleton OTUs:              {options.includeuniqueseqs}",
        f"PIPITS Process Version:               {__version__}"
    ]
    try:
        with open(summary_file_path, "w") as sf:
            for line in summary_lines: sf.write(line + "\n")
            try:
                end_time = time.time(); total_time = end_time - start_time
                sf.write(f"\nProcessing completed in {total_time:.2f} seconds.\n")
            except NameError: pass # start_time might not be defined if exited early
    except IOError as e:
        logging.warning(f"Could not write summary file {summary_file_path}: {e}")

    # --- Final Log Messages ---
    logging.info("--- Summary ---")
    logging.info(f"\tNumber of reads in final OTU table: {int(otu_reads_count) if isinstance(otu_reads_count, (int, float)) and otu_reads_count != 'N/A' else otu_reads_count}")
    logging.info(f"\tNumber of OTUs:                       {otu_count}")
    logging.info(f"\tNumber of samples:                    {otu_sample_count}")
    logging.info(f"\tUNITE DB version:                     {options.unite}")
    logging.info(f"\tTaxonomy Method Used (for stats):     {stats_method if stats_method else 'N/A'}")
    logging.info(f"\tPIPITS version:                       {__version__}")
    try:
        end_time = time.time(); total_time = end_time - start_time
        logging.info(f"pipits_process finished successfully in {total_time:.2f} seconds.")
    except NameError:
        logging.info("pipits_process finished (possibly with early exit).")
    logging.info(f"Done - Resulting files are in '{options.outDir}' directory")
