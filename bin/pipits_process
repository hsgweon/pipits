        required = False)
    parser.add_argument(
        "--taxassignmentmethod",
        action = "store",
        dest = "taxassignmentmethod",
        help = "Choice of taxonomic assignment. By default, PIPITS will run SINTAX (VSEARCH). Selecting 'all' runs both RDP and SINTAX. Databases downloaded automatically unless --ignore-db-download is specified.",
        choices = ["all", "rdp", "sin"],
        default = "sin",
        required = False)
    parser.add_argument(
        "--unite",
        action = "store",
        dest = "unite",
        help = "UNITE db version to be used - PIPITS will download db automaticlly unless --ignore-db-download is specified. Leaving this option out will default to the most recent version of UNITE available to PIPITS.",
